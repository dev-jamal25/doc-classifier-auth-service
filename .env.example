# App behavior
APP_ENV=development
LOG_LEVEL=INFO
REQUEST_ID_HEADER=X-Request-ID

# API
API_PORT=8000

# Frontend
FRONTEND_PORT=3000

# Worker
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_MAX_CONCURRENCY=2
WORKER_QUEUE_NAME=doc-jobs

# SFTP endpoint config only (credentials are Vault secrets)
# Docker Compose default service host is "sftp".
SFTP_HOST=sftp
SFTP_PORT=22
SFTP_REMOTE_DIR=/upload
SFTP_QUARANTINE_DIR=/quarantine
SFTP_POLL_INTERVAL_SECONDS=5
MAX_SFTP_FILE_SIZE_BYTES=52428800

# MinIO endpoint config only (access key/secret key are Vault secrets)
# Docker Compose default service host is "minio".
MINIO_ENDPOINT=http://minio:9000
MINIO_RAW_BUCKET=documents-raw
MINIO_OVERLAY_BUCKET=documents-overlays

# Redis endpoint config only (credentialed URL is Vault-managed if introduced)
# Docker Compose default service host is "redis".
REDIS_URL=redis://redis:6379/0

# Vault bootstrap config (app runtime secrets are read from Vault, not .env)
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=dev-only-root-token
VAULT_KV_MOUNT=secret
VAULT_KV_BASE_PATH=doc-classifier

# Classifier artifacts
CLASSIFIER_MODEL_PATH=app/classifier/models/classifier.pt
CLASSIFIER_MODEL_CARD_PATH=app/classifier/models/model_card.json
CLASSIFIER_GOLDEN_IMAGES_DIR=app/classifier/eval/golden_images
CLASSIFIER_MIN_TEST_TOP1=0.70
USE_MOCK_CLASSIFIER=false
