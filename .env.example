# Shared
APP_ENV=development
LOG_LEVEL=INFO
REQUEST_ID_HEADER=X-Request-ID

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
API_AUTH_JWT_SECRET=replace-me
API_AUTH_JWT_ALGORITHM=HS256
API_AUTH_JWT_EXP_MINUTES=60

# Worker
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_MAX_CONCURRENCY=2
WORKER_QUEUE_NAME=doc-jobs

# Ingestion
SFTP_HOST=sftp.example.local
SFTP_PORT=22
SFTP_USERNAME=example-user
SFTP_PASSWORD=example-password
SFTP_REMOTE_DIR=/incoming
SFTP_POLL_INTERVAL_SECONDS=30

# DB
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=doc_classifier
POSTGRES_USER=doc_user
POSTGRES_PASSWORD=example-password
DATABASE_URL=postgresql+psycopg://doc_user:example-password@localhost:5432/doc_classifier

# Classifier
CLASSIFIER_MODEL_PATH=app/classifier/models/classifier.pt
CLASSIFIER_GOLDEN_IMAGES_DIR=app/classifier/eval/golden_images
CLASSIFIER_THRESHOLD=0.50
